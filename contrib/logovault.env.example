# Copy to /etc/logovault.env and chmod 600. Holds API keys, so it is never
# committed: the repository's .gitignore excludes *.env.
#
# Emby: Dashboard > Advanced > API Keys > New API Key.

EMBY_URL=http://192.168.1.10:8096
EMBY_API_KEY=replace_me
EMBY_LOGO_VAULT=/opt/logovault/vault

# Dispatcharr, optional. Leave these out and the tool runs Emby only.
# Uploading a logo needs an admin level account.
#DISPATCHARR_URL=http://192.168.1.10:9191
#DISPATCHARR_API_KEY=replace_me

# Or, instead of an API key:
#DISPATCHARR_USER=admin
#DISPATCHARR_PASS=replace_me
